import sys
import os

# Add src directory to Python path
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from compiler import Compiler
from errors import EXIT_INTERNAL


def main():
    """Main entry point matching the VYPa project CLI."""
    if len(sys.argv) < 2 or len(sys.argv) > 3:
        print(
            "Usage: vypcomp INPUT_FILE [OUTPUT_FILE]",
            file=sys.stderr,
        )
        sys.exit(EXIT_INTERNAL)

    input_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) == 3 else "out.vc"

    if not os.path.exists(input_file):
        print(f"Error: Input file '{input_file}' not found", file=sys.stderr)
        sys.exit(EXIT_INTERNAL)

    try:
        with open(input_file, "r", encoding="utf-8") as f:
            source_code = f.read()
    except OSError as e:
        print(f"Error reading input file: {e}", file=sys.stderr)
        sys.exit(EXIT_INTERNAL)

    compiler = Compiler()
    code = compiler.compile(source_code, output_file)
    sys.exit(code)


if __name__ == "__main__":
    main()
