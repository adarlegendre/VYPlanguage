#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1

# Program entry: call main, then halt
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
SET $2, 0
SET $3, 0
CREATE $1, 1
SETWORD $1, 0, "Enter an integer to compute its factorial:"
GETWORD $1, $1, 0
WRITES $1
READI $4
SET $2, $4
LTI $4, $2, 0
JUMPZ L1, $4
CREATE $1, 1
SETWORD $1, 0, "\nFactorial of a negative integer is undefined!\n"
GETWORD $1, $1, 0
WRITES $1
JUMP L2
LABEL L1
SET $3, 1
LABEL L3
GTI $4, $2, 0
JUMPZ L4, $4
MULI $4, $3, $2
SET $3, $4
SUBI $4, $2, 1
SET $2, $4
JUMP L3
LABEL L4
CREATE $1, 1
SETWORD $1, 0, "\nThe result is: "
GETWORD $1, $1, 0
WRITES $1
WRITEI $3
CREATE $1, 1
SETWORD $1, 0, "\n"
GETWORD $1, $1, 0
WRITES $1
LABEL L2
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL _end
