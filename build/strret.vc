#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1
ALIAS BX $2
ALIAS CX $3
ALIAS OBJ $4
ALIAS EX $5
ALIAS SI $6
ALIAS DI $7

# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL greet
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
CREATE $AX, 1
SETWORD $AX, 0, "hi"
GETWORD $AX, $AX, 0
SET [$BP-2], $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
CREATE $AX, 1
SETWORD $AX, 0, ""
GETWORD $AX, $AX, 0
COPY $BX, $AX
SET [$BP+1], $BX
ADDI $SP, $SP, 1
SET [$SP], 0
CALL [$SP+1], greet
SET $AX, [$SP]
SET [$BP+2], $AX
SUBI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], [$BP+2]
CREATE $AX, 1
SETWORD $AX, 0, "!"
GETWORD $AX, $AX, 0
ADDI $SP, $SP, 1
SET [$SP], $AX
CALL [$SP+1], __str_concat__
SET $AX, [$SP]
SET [$BP+3], $AX
SUBI $SP, $SP, 1
SET $AX, [$BP+3]
COPY $BX, $AX
SET [$BP+1], $BX
SET $AX, [$BP+1]
WRITES $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL __str_concat__
SUBI $SP, $SP, 1
GETSIZE $BX, [$SP]
GETSIZE $EX, [$SP+1]
COPY $DI, [$SP]
ADDI $AX, $BX, $EX
RESIZE $DI, $AX
SET $CX, 0
LABEL __str_concat__loop
LTI $AX, $CX, $EX
JUMPZ __str_concat__end, $AX
GETWORD $SI, [$SP+1], $CX
SETWORD $DI, $BX, $SI
ADDI $BX, $BX, 1
ADDI $CX, $CX, 1
JUMP __str_concat__loop
LABEL __str_concat__end
SET [$SP], $DI
RETURN [$SP+2]

LABEL _end
