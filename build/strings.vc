GETSIZE $AX, [$SP-2]
LTI $EX, [$SP-1], $AX
NOT $EX, $EX
JUMPNZ subStr_end, $EX
ADDI $EX, [$SP-1], [$SP]
GETSIZE $AX, [$SP-2]
GTI $CX, $EX, $AX
JUMPZ subStr_min_end, $CX
SUBI $EX, $AX, [$SP-1]
