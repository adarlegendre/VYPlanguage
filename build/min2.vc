#! /bin/vypint
# VYPcode: 1.0
# Generated by: test

ALIAS AX $1
ALIAS DI $7

SET $0 $SP
CALL [$SP+1] main
JUMP _end

LABEL main
ADDI $SP $SP 1
ADDI $SP $SP 1
SET [$SP] $0
SET $0 $SP

CREATE $DI 1
SETWORD $DI 0 "Sum: "
GETWORD $DI $DI 0
WRITES $DI
WRITEI 15
CREATE $DI 1
SETWORD $DI 0 "\n"
GETWORD $DI $DI 0
WRITES $DI

SET $SP $0
SET $0 [$SP]
SUBI $SP $SP 1
SUBI $SP $SP 1
RETURN [$SP+1]

LABEL _end
