LABEL A:A
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
SET $OBJ, [$BP-2]
SET $AX, 1
SETWORD $OBJ, 3, $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL A:get
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
SET $OBJ, [$BP-2]
GETWORD $AX, $OBJ, 3
SET [$BP+1], $AX
SET $AX, [$BP+1]
SET [$BP-2], $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL B:B
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL B:bad
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET $OBJ, [$BP-2]
GETWORD $AX, $OBJ, 3
SET [$BP+1], $AX
SET $OBJ, [$BP+1]
GETWORD $AX, $OBJ, 3
SET [$BP+2], $AX
SET $AX, [$BP+2]
SET [$BP-2], $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
# new B
CREATE $AX, 4
SETWORD $AX, 0, [2]
SETWORD $AX, 1, [0]
SETWORD $AX, 2, "B"
SETWORD $AX, 3, 0
SET [$BP+2], $AX
ADDI $SP, $SP, 1
SET [$SP], [$BP+2]
CALL [$SP+1], B:B
SUBI $SP, $SP, 1
SET [$BP+1], [$BP+2]
# new A
CREATE $AX, 4
SETWORD $AX, 0, [1]
SETWORD $AX, 1, [0]
SETWORD $AX, 2, "A"
SETWORD $AX, 3, 0
SET [$BP+3], $AX
ADDI $SP, $SP, 1
SET [$SP], [$BP+3]
CALL [$SP+1], A:A
SUBI $SP, $SP, 1
SET $OBJ, [$BP+1]
SET $AX, [$BP+3]
SETWORD $OBJ, 3, $AX
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
SET $OBJ, [$SP]
GETWORD $AX, $OBJ, 0
GETWORD $AX, $AX, 3
CALL [$SP+1], $AX
SET $AX, [$SP]
SET [$BP+4], $AX
SUBI $SP, $SP, 1
WRITEI [$BP+4]
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL _end
