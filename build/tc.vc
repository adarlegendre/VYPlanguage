# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for A
CREATE $AX, 4
