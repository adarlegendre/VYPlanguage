SETWORD $AX, 1, "Object:getClass"
SETWORD $AX, 2, "A:A"
SETWORD $AX, 3, "A:get"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for B
CREATE $AX, 4
