#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1
ALIAS BX $2
ALIAS CX $3
ALIAS EX $5
ALIAS SI $6
ALIAS DI $7

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
SET [$BP+2], 0
CREATE $AX, 1
SETWORD $AX, 0, "Enter an integer to compute its factorial:"
GETWORD $AX, $AX, 0
WRITES $AX
READI $AX
SET [$BP+3], $AX
SET [$BP+1], [$BP+3]
LTI $AX, [$BP+1], 0
SET [$BP+4], $AX
SET $AX, [$BP+4]
JUMPZ L1, $AX
CREATE $AX, 1
SETWORD $AX, 0, "\nFactorial of a negative integer is undefined!\n"
GETWORD $AX, $AX, 0
WRITES $AX
JUMP L2
LABEL L1
SET [$BP+2], 1
LABEL L3
GTI $AX, [$BP+1], 0
SET [$BP+5], $AX
SET $AX, [$BP+5]
JUMPZ L4, $AX
MULI $AX, [$BP+2], [$BP+1]
SET [$BP+6], $AX
SET [$BP+2], [$BP+6]
SUBI $AX, [$BP+1], 1
SET [$BP+7], $AX
SET [$BP+1], [$BP+7]
JUMP L3
LABEL L4
CREATE $AX, 1
SETWORD $AX, 0, "\nThe result is: "
GETWORD $AX, $AX, 0
WRITES $AX
WRITEI [$BP+2]
CREATE $AX, 1
SETWORD $AX, 0, "\n"
GETWORD $AX, $AX, 0
WRITES $AX
LABEL L2
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL _end
