#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1
ALIAS BX $2
ALIAS CX $3
ALIAS OBJ $4
ALIAS EX $5
ALIAS SI $6
ALIAS DI $7

# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for C
CREATE $AX, 3
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SETWORD $AX, 2, "C:bump"
SET [$SP], $AX
ADDI $SP, $SP, 1

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL C:bump
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET $OBJ, [$BP-3]
GETWORD $AX, $OBJ, 3
SET [$BP+1], $AX
ADDI $AX, [$BP+1], [$BP-2]
SET [$BP+2], $AX
SET $AX, [$BP+2]
SET [$BP-3], $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 2
RETURN [$SP+2]

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
# new C
CREATE $AX, 4
SETWORD $AX, 0, [1]
SETWORD $AX, 1, [0]
SETWORD $AX, 2, "C"
SETWORD $AX, 3, 0
SET [$BP+2], $AX
SET [$BP+1], [$BP+2]
SET $OBJ, [$BP+1]
SET $AX, 1
SETWORD $OBJ, 3, $AX
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
SET $OBJ, [$SP]
ADDI $SP, $SP, 1
SET [$SP], 2
GETWORD $AX, $OBJ, 0
GETWORD $AX, $AX, 2
CALL [$SP+1], $AX
SET $AX, [$SP]
SET [$BP+3], $AX
SUBI $SP, $SP, 1
WRITEI [$BP+3]
CREATE $AX, 1
SETWORD $AX, 0, "\n"
GETWORD $AX, $AX, 0
WRITES $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL _end
