# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
# new Object
CREATE $AX, 3
SETWORD $AX, 0, [0]
SETWORD $AX, 1, [0]
SETWORD $AX, 2, "Object"
SET [$BP+2], $AX
SET [$BP+1], [$BP+2]
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
SET $OBJ, [$SP]
GETWORD $AX, $OBJ, 0
GETWORD $AX, $AX, 0
CALL [$SP+1], $AX
SET $AX, [$SP]
SET [$BP+3], $AX
SUBI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
SET $OBJ, [$SP]
GETWORD $AX, $OBJ, 0
GETWORD $AX, $AX, 1
CALL [$SP+1], $AX
SET $AX, [$SP]
SET [$BP+4], $AX
SUBI $SP, $SP, 1
SET $AX, [$BP+3]
WRITES $AX
SET $AX, [$BP+4]
WRITES $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL _end
