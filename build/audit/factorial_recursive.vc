WRITES $AX
JUMP L2
LABEL L1
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
CALL [$SP+1], factorial
SET $AX, [$SP]
SET [$BP+5], $AX
SUBI $SP, $SP, 1
CREATE $AX, 1
SETWORD $AX, 0, "\nThe result is: "
GETWORD $AX, $AX, 0
WRITES $AX
WRITEI [$BP+5]
CREATE $AX, 1
SETWORD $AX, 0, "\n"
GETWORD $AX, $AX, 0
WRITES $AX
LABEL L2
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL factorial
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
