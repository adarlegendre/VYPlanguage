SET $AX, 1
SET [$BP-2], $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]
JUMP L4
LABEL L3
SUBI $AX, [$BP-2], 1
SET [$BP+4], $AX
SET [$BP+1], [$BP+4]
ADDI $SP, $SP, 1
SET [$SP], [$BP+1]
CALL [$SP+1], factorial
SET $AX, [$SP]
SET [$BP+5], $AX
SUBI $SP, $SP, 1
SET [$BP+2], [$BP+5]
LABEL L4
MULI $AX, [$BP-2], [$BP+2]
