#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1
ALIAS BX $2
ALIAS CX $3
ALIAS OBJ $4
ALIAS EX $5
ALIAS SI $6
ALIAS DI $7

# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for A
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for B
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
# new B
CREATE $AX, 3
SETWORD $AX, 0, [2]
SETWORD $AX, 1, [1]
SETWORD $AX, 2, "B"
SET [$BP+3], $AX
SET [$BP+1], [$BP+3]
SET [$BP+2], 0
SET $AX, [$BP+1]
# dynamic cast to B
JUMPZ __cast_fail_2, $AX
GETWORD $BX, $AX, 2
CREATE $CX, 1
SETWORD $CX, 0, "B"
GETWORD $CX, $CX, 0
EQS $DI, $BX, $CX
JUMPNZ __cast_ok_1, $DI
LABEL __cast_fail_2
GETWORD $DI, 0, 0
LABEL __cast_ok_1
SET [$BP+4], $AX
SET [$BP+2], [$BP+4]
CREATE $AX, 1
SETWORD $AX, 0, "ok"
GETWORD $AX, $AX, 0
WRITES $AX
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL _end
