#! /bin/vypint
# VYPcode: 1.0
# Generated by: VYPlanguage Compiler

ALIAS BP $0
ALIAS AX $1
ALIAS BX $2
ALIAS CX $3
ALIAS OBJ $4
ALIAS EX $5
ALIAS SI $6
ALIAS DI $7

# VMT for Object
CREATE $AX, 2
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SET [$SP], $AX
ADDI $SP, $SP, 1

# VMT for A
CREATE $AX, 3
SETWORD $AX, 0, "Object:toString"
SETWORD $AX, 1, "Object:getClass"
SETWORD $AX, 2, "A:A"
SET [$SP], $AX
ADDI $SP, $SP, 1

# Program entry
SET $BP, $SP
CALL [$SP+1], main
JUMP _end

LABEL A:A
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL main
ADDI $SP, $SP, 1
ADDI $SP, $SP, 1
SET [$SP], $BP
SET $BP, $SP
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
ADDI $SP, $SP, 1
SET [$SP], 0
SET [$BP+1], 0
SET [$BP+2], 0
SET [$BP+3], 0
# new A
CREATE $AX, 3
SETWORD $AX, 0, [1]
SETWORD $AX, 1, [0]
SETWORD $AX, 2, "A"
SET [$BP+4], $AX
ADDI $SP, $SP, 1
SET [$SP], [$BP+4]
CALL [$SP+1], A:A
SUBI $SP, $SP, 1
SET [$BP+1], [$BP+4]
SET [$BP+2], [$BP+1]
EQI $AX, [$BP+1], [$BP+2]
SET [$BP+5], $AX
WRITEI [$BP+5]
EQI $AX, [$BP+1], [$BP+3]
SET [$BP+6], $AX
WRITEI [$BP+6]
SET $AX, [$BP+3]
NOT $AX, $AX
SET [$BP+7], $AX
WRITEI [$BP+7]
AND $AX, [$BP+1], 1
SET [$BP+8], $AX
WRITEI [$BP+8]
SET $SP, $BP
SET $BP, [$SP]
SUBI $SP, $SP, 1
SUBI $SP, $SP, 1
RETURN [$SP+1]

LABEL Object:toString
INT2STRING $AX, [$SP]
SET [$SP], $AX
RETURN [$SP+1]

LABEL Object:getClass
GETWORD $AX, [$SP], 2
SET [$SP], $AX
RETURN [$SP+1]

LABEL _end
