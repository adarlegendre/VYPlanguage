// Arithmetic operations test
void main(void) {
    int a, b;
    int add_result, sub_result, mul_result, div_result;
    a = 15;
    b = 3;
    add_result = a + b;
    sub_result = a - b;
    mul_result = a * b;
    div_result = a / b;
    print("Arithmetic Results:\n");
    print(add_result, "\n");
    print(sub_result, "\n");
    print(mul_result, "\n");
    print(div_result, "\n");
}
