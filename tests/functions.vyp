// Function definition test
int add(int a, int b) {
    return a + b;
}

int multiply(int a, int b) {
    return a * b;
}

void main(void) {
    int x, y, sum, product;
    x = 5;
    y = 3;
    sum = add(x, y);
    product = multiply(x, y);
    print("Sum: ", sum, "\n");
    print("Product: ", product, "\n");
}
