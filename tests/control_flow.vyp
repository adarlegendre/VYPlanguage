// Control flow test (if / while)
void main(void) {
    int x, y, i;
    x = 10;
    y = 20;
    if (x > y) {
        print("x is greater than y\n");
    } else {
        print("y is greater than or equal to x\n");
    }
    i = 0;
    while (i < 5) {
        print(i, "\n");
        i = i + 1;
    }
}
